# Public website origin. Do not include a trailing slash.
PALANG_SITE_URL=https://www.youjing.dev

# Airwallex Hosted Payment Page (start with demo, then switch to prod).
PALANG_DESKTOP_SALES_ENABLED=false
AIRWALLEX_ENV=demo
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=

# Generate at least 32 random bytes, for example: openssl rand -base64 48
PALANG_DESKTOP_TOKEN_SECRET=

# Durable order storage (Upstash Redis REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Durable webhook-to-fulfillment queue (Upstash QStash).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Paid-order email delivery (Resend).
RESEND_API_KEY=
PALANG_DESKTOP_FROM_EMAIL=Palang IC <downloads@updates.youjing.dev>

# Private S3-compatible artifact storage (AWS S3 or Cloudflare R2).
PALANG_DESKTOP_STORAGE_ENDPOINT=
PALANG_DESKTOP_STORAGE_REGION=auto
PALANG_DESKTOP_STORAGE_BUCKET=
PALANG_DESKTOP_STORAGE_ACCESS_KEY_ID=
PALANG_DESKTOP_STORAGE_SECRET_ACCESS_KEY=
PALANG_DESKTOP_STORAGE_FORCE_PATH_STYLE=false

# Immutable, versioned object keys. Upload only signed release artifacts.
PALANG_DESKTOP_ARTIFACT_MAC_ARM64_KEY=releases/0.1.0/palang-ic-mac-arm64.dmg
PALANG_DESKTOP_ARTIFACT_MAC_ARM64_SIZE_BYTES=
PALANG_DESKTOP_ARTIFACT_MAC_ARM64_SHA256=
PALANG_DESKTOP_ARTIFACT_MAC_X64_KEY=releases/0.1.0/palang-ic-mac-x64.dmg
PALANG_DESKTOP_ARTIFACT_MAC_X64_SIZE_BYTES=
PALANG_DESKTOP_ARTIFACT_MAC_X64_SHA256=
PALANG_DESKTOP_ARTIFACT_WINDOWS_X64_KEY=releases/0.1.0/palang-ic-windows-x64.exe
PALANG_DESKTOP_ARTIFACT_WINDOWS_X64_SIZE_BYTES=
PALANG_DESKTOP_ARTIFACT_WINDOWS_X64_SHA256=
