{
  "name": "palang-ic-desktop",
  "version": "0.1.0",
  "description": "Private, offline identity-card watermarking for macOS and Windows",
  "author": "You Jing",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/package-targets.mjs current-platform",
    "dist:mac": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/package-targets.mjs mac-arm64 mac-x64",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/package-targets.mjs win-x64",
    "dist:signed": "npm run build && node scripts/package-targets.mjs current-platform",
    "dist:verify": "node scripts/verify-native-package.mjs"
  },
  "dependencies": {
    "pdf-lib": "latest",
    "sharp": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.0.0",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-vite": "^5.0.0",
    "playwright": "^1.61.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.0",
    "vite": "^7.3.0",
    "vitest": "latest"
  },
  "build": {
    "appId": "dev.youjing.palangic",
    "productName": "Palang IC",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
